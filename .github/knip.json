{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    "Frontend-PWA": {
      "entry": [
        "src/app/sw.ts"
      ],
      "project": "src/**/*.{ts,vue}"
    },
    ".": {
      "entry": [
        "Backend/supabase/functions/*/index.ts",
        ".github/scripts/*.ts"
      ],
      "project": [
        "Backend/supabase/functions/**/*.ts",
        ".github/scripts/*.ts"
      ],
      "ignoreDependencies": ["npm"],
      "ignoreBinaries": ["tsx", "wait-on"]
    }
  },
  "compilers": {
    "vue": "npx @vue/compiler-sfc"
  }
}
