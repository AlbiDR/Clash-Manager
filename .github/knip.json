{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    "Frontend-PWA": {
      "project": "src/**/*.{ts,vue}",
      "ignoreExportsUsedInFile": true,
      "ignoreUnresolved": [
        "virtual:pwa-register/vue"
      ]
    },
    "Backend": {
      "entry": "supabase/functions/*/index.ts",
      "project": "supabase/functions/**/*.ts",
      "ignoreDependencies": ["p-limit"]
    },
    ".": {
      "entry": ".github/scripts/**/*.ts",
      "project": ".github/scripts/**/*.ts",
      "ignoreDependencies": ["npm", "p-limit"],
      "ignoreBinaries": ["playwright", "adb", "strings", "type-check", "lint"]
    }
  },
  "ignoreIssues": {
    "Frontend-PWA/src/core/config/index.ts": ["duplicates"]
  },
  "compilers": {
    "vue": "npx @vue/compiler-sfc"
  }
}
