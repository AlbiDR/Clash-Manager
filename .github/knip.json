{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    "Frontend-PWA": {
      "entry": [
        "src/app/main.ts",
        "src/app/sw.ts"
      ],
      "project": "src/**/*.{ts,vue}",
      "ignore": [
        "src/env.d.ts"
      ],
      "ignoreUnresolved": [
        "virtual:pwa-register/vue"
      ]
    },
    "Backend": {
      "entry": "supabase/functions/*/index.ts",
      "project": "supabase/functions/**/*.ts"
    },
    ".": {
      "entry": ".github/scripts/*.ts",
      "project": ".github/scripts/*.ts",
      "ignoreDependencies": ["npm"],
      "ignoreBinaries": ["wait-on"]
    }
  },
  "compilers": {
    "vue": "npx @vue/compiler-sfc"
  }
}
