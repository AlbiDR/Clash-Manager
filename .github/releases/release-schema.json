{
  "type": "object",
  "required": [
    "versioning_logic",
    "release_summary",
    "key_improvements",
    "deep_dive",
    "files_modified",
    "full_changelog_url",
    "final_markdown_output"
  ],
  "properties": {
    "versioning_logic": {
      "type": "object",
      "required": ["previous_version", "new_version", "impact_level", "reasoning"],
      "properties": {
        "previous_version": { "type": "string" },
        "new_version": { "type": "string" },
        "impact_level": { "type": "string", "enum": ["Major", "Minor", "Patch"] },
        "reasoning": { 
          "type": "string", 
          "description": "Logic-driven reasoning for the version bump. Note: The IDE must handle/create tags to maintain the git log chain."
        }
      }
    },
    "release_summary": {
      "type": "string",
      "description": "The 'Hero' paragraph. A high-level, project-centric narrative (passive voice). Tone: Approachable, insightful, and genuine (acknowledging solo-use nature despite live status). No emojis."
    },
    "key_improvements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "context", "summary", "details"],
        "properties": {
          "title": { "type": "string", "description": "Clinical title (e.g., '1. Type Safety Hardening'). No emojis. Passive voice." },
          "context": { "type": "string", "description": "System-centric context. No 'I/We'." },
          "summary": { "type": "string", "description": "Passive voice only." },
          "details": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["bold_label", "description"],
              "properties": {
                "bold_label": { "type": "string" },
                "description": { "type": "string", "description": "Passive voice only." },
                "sub_points": { 
                  "type": "array", 
                  "items": { "type": "string" },
                  "description": "Optional nested bullets. Passive voice only."
                }
              }
            }
          }
        }
      }
    },
    "deep_dive": {
      "type": "object",
      "required": ["title", "type", "problem_statement", "root_cause_analysis", "solution_implementation"],
      "properties": {
        "title": { "type": "string" },
        "type": { "type": "string", "enum": ["Bug Fix", "Architecture Spotlight", "Strategic Pivot"] },
        "problem_statement": { "type": "string", "description": "Insightful description of the hurdle. Passive voice." },
        "root_cause_analysis": { "type": "array", "items": { "type": "string" }, "description": "Deeply analytical. Passive voice." },
        "solution_implementation": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["step", "outcome"],
            "properties": {
              "step": { "type": "string", "description": "Command mood or passive voice." },
              "outcome": { "type": "string", "description": "Passive voice only." }
            }
          }
        }
      }
    },
    "files_modified": {
      "type": "object",
      "required": ["sections", "omission_strategy"],
      "properties": {
        "sections": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["component_name", "file_list"],
            "properties": {
              "component_name": { 
                "type": "string", 
                "enum": ["@substrate", "@core", "@shared", "@features", "@app", "@root"],
                "description": "Must correspond exactly to the ADR Layer names."
              },
              "file_list": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["filename", "change_summary"],
                  "properties": {
                    "filename": { "type": "string" },
                    "change_summary": { "type": "string", "description": "Passive voice only." }
                  }
                }
              }
            }
          }
        },
        "omission_strategy": {
          "type": "string",
          "description": "Formatting string (e.g., '* - [Count] additional files omitted for brevity.')."
        }
      }
    },
    "full_changelog_url": {
      "type": "string",
      "description": "Absolute URL to GitHub comparison. Mandatory for git log integrity."
    },
    "final_markdown_output": {
      "type": "string",
      "description": "Clinical OCD Formatting. Must use exact separators: '\\n---\\n<br>\\n' before H2 headers. End with Full Changelog line then EXACTLY '\\n---\\n---'. No emojis. Scannable bold highlights. Passive voice throughout."
    }
  }
}

