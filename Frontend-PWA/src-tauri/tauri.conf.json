{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ClashManager",
  "version": "8.11.0",
  "identifier": "com.albidr.clashmanager",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Clash Manager",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "schemes": ["clashmanager"],
      "host": "albidr.github.io"
    },
    "notification": {},
    "fs": {},
    "os": {},
    "shell": {},
    "http": {},
    "dialog": {}
  }
}
