{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "notification:default",
    {
      "identifier": "shell:allow-open",
      "allow": [
        {
          "schemes": ["http", "https"]
        }
      ]
    },
    "http:default",
    "fs:default",
    "dialog:default",
    "os:default",
    "deep-link:default"
  ]
}
