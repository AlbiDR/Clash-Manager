{
  "$schema": "https://schema.tauri.app/capability/1",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "notification:default",
    {
      "identifier": "shell:allow-open",
      "allow": [
        {
          "schemes": ["http", "https"],
          "urls": ["https://albidr.github.io/Clash-Manager/*"]
        }
      ]
    },
    "http:default",
    "fs:default",
    "dialog:default",
    "os:default",
    "deep-link:default"
  ]
}
