        { "src": "assets/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
        { "src": "assets/icons/pwa-maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
      ]
    },
    {
      "name": "Headhunter",
      "short_name": "Headhunter",
