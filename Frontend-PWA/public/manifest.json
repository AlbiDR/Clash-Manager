{
  "name": "Clash Manager",
  "short_name": "Clash Manager",
  "description": "Professional recruitment and performance analytics dashboard for Clash Royale clan leaders.",
  "theme_color": "#0b0e14",
  "background_color": "#0b0e14",
  "display": "standalone",
  "scope": "./",
  "start_url": "./#/leaderboard",
  "id": "clash-manager-pwa",
  "icons": [
    {
      "src": "logo.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "logo.webp",
      "sizes": "192x192 512x512",
      "type": "image/webp",
      "purpose": "any"
    },
    {
      "src": "logo-maskable.webp",
      "sizes": "512x512",
      "type": "image/webp",
      "purpose": "maskable"
    },
    {
