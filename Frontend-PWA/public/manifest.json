      "sizes": "180x180",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "screenshots": [
    {
      "src": "screenshot-mobile-light.webp",
      "sizes": "1080x1920",
      "type": "image/webp",
      "form_factor": "narrow",
      "label": "Clash Manager Mobile (Light)"
    },
    {
      "src": "screenshot-mobile-dark.webp",
      "sizes": "1080x1920",
      "type": "image/webp",
      "form_factor": "narrow",
      "label": "Clash Manager Mobile (Dark)"
    },
    {
      "src": "screenshot-desktop-light.webp",
      "sizes": "1920x1080",
      "type": "image/webp",
      "form_factor": "wide",
      "label": "Clash Manager Desktop (Light)"
    },
    {
      "src": "screenshot-desktop-dark.webp",
      "sizes": "1920x1080",
      "type": "image/webp",
      "form_factor": "wide",
      "label": "Clash Manager Desktop (Dark)"
    }
  ]
