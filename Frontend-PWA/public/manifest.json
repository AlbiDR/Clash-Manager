{
  "name": "Clash Manager",
  "short_name": "Clash Manager",
  "description": "Professional recruitment and performance analytics dashboard for Clash Royale clan leaders.",
  "theme_color": "#0b0e14",
  "background_color": "#0b0e14",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "scope": "/Clash-Manager/",
  "start_url": "/Clash-Manager/#/roster",
  "id": "clash-manager",
  "orientation": "natural",
  "categories": ["productivity", "games", "utilities"],
  "lang": "en",
  "dir": "ltr",
  "handle_links": "preferred",
  "share_target": {
    "action": "/Clash-Manager/#/headhunter",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "edge_side_panel": {
    "preferred_width": 400
  },
  "icons": [
    {
      "src": "assets/branding/logo.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "assets/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/icons/pwa-maskable.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "maskable"
    },
    {
      "src": "assets/icons/pwa-icon-monochrome.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "monochrome"
    },
    {
      "src": "assets/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "screenshots": [
    {
      "src": "assets/branding/headhunter-light.webp",
      "sizes": "1080x1920",
      "type": "image/webp",
      "form_factor": "narrow",
      "label": "Clash Manager Headhunter (Light)"
    },
    {
      "src": "assets/branding/headhunter-dark.webp",
      "sizes": "1080x1920",
      "type": "image/webp",
      "form_factor": "narrow",
      "label": "Clash Manager Headhunter (Dark)"
    },
    {
      "src": "assets/branding/roster-light.webp",
      "sizes": "1920x1080",
      "type": "image/webp",
      "form_factor": "wide",
      "label": "Clash Manager Roster (Light)"
    },
    {
      "src": "assets/branding/roster-dark.webp",
      "sizes": "1920x1080",
      "type": "image/webp",
      "form_factor": "wide",
      "label": "Clash Manager Roster (Dark)"
    }
  ],
  "launch_handler": {
    "client_mode": ["navigate-existing", "auto"]
  },
  "shortcuts": [
    {
      "name": "Roster",
