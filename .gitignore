# AI & Temporary Configs
# Agent tooling: session artifacts stay local, but the SHARED definitions
# (workflows, skills, rules) are tracked so every agent on every machine
# reads the same ones. They used to be wholly ignored, which meant the same
# workflow was hand-recreated per tool, drifted apart, and vanished on a
# fresh clone.
.agent/*
!.agent/workflows/
!.agent/skills/
.agents/*
!.agents/rules/
_agent
_agents
.gemini
.cursor
.jules
.mcp
# Claude Code personal settings - contains API tokens; never commit
.claude/settings.local.json
.claude/*
!.claude/skills/
# Never the local settings: they hold API credentials.
.claude/settings.local.json

# Dependencies
node_modules
.pnpm-store

# Build outputs
dist
build
out
*.tsbuildinfo

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
workflow_logs.txt
*.log
!.github/nightly-logs/*.log

# System Files
.DS_Store
Thumbs.db
.directory

# Editor directories
.idea
.vscode
*.swp
*.swo
.history/
*.code-workspace

# Environment variables and Secrets
.env
.env.local
.env.*.local
secrets/
secrets.json
credentials.json
*.pem
*.key
*.crt

# Python
__pycache__/
*.py[cod]
.venv/

# Temporary files
*.tmp
*.bak

# PWA / Vite Generated
public/sw.js
public/workbox-*.js
stats.html

# Testing
coverage

# Release Temp Changelogs
.github/releases/_changelog_*

# Generated Assets
Frontend-PWA/index.html
Frontend-PWA/src/core/theme/bones.generated.json
Frontend-PWA/.cache/

# Supabase & Backend Temp
supabase/.temp/
Backend/supabase/.temp/
Backend/scripts/data/

# Local Tools & Tests
mcp_config.json
test-stack.js
Frontend-PWA/test-stack.js
verification/
functions_*.txt

# Android Build Artifacts (keep out of repo)
*.apk
*.aab
*.keystore
# ...but DO track the one ground-truth reference APK (the recovered native layer
# is the irreplaceable IP - this is its proven, signed source-of-truth binary).
!APK/reference/clashmanager-v4.apk
/assetlinks.json
!Frontend-PWA/public/.well-known/assetlinks.json

# Android icon-generator preview output (gen-android-icons.mjs --preview)
.icon-preview/

# Android build outputs (apktool b / build-apk.sh) - sources live in APK/android/
APK/android/build/
# Intermediates stay ignored; the versioned signed release APK is tracked (exception below).
APK/release/*
!APK/release/clashmanager-v*.apk
# Pointer to the current release filename (version+buildNumber) - lets the PWA
# download link and scripts find it without hardcoding the build number.
!APK/release/latest.json


APK/.build
