{
  "name": "clash-manager-monorepo",
  "version": "14.50.21",
  "license": "GPL-3.0-only",
  "private": true,
  "scripts": {
    "deploy:pwa": "pnpm -F clash-manager-pwa build",
    "dev:pwa": "pnpm -F clash-manager-pwa dev",
    "icons:android": "node APK/gen-android-icons.mjs",
    "apk:check": "./APK/build-apk.sh --no-sign",
    "apk:verify": "node APK/verify-apk-integrity.mjs",
    "apk:verify:source": "node APK/verify-android-source.mjs APK/android",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "version:bump": "node .github/scripts/project/bump-version.mjs",
    "version:bump:minor": "node .github/scripts/project/bump-version.mjs minor",
    "version:bump:major": "node .github/scripts/project/bump-version.mjs major",
    "audit:version": "tsx .github/scripts/project/validate-project.ts",
    "audit:version:fix": "tsx .github/scripts/project/validate-project.ts --fix",
    "audit:migrations": "node .github/scripts/database/audit-migrations.mjs",
    "audit:apk-ux": "node .github/scripts/android/audit-apk-ux.mjs",
    "test:migration-audit": "node --test .github/scripts/database/sql-lexer.test.mjs .github/scripts/database/audit-migrations.test.mjs .github/scripts/database/fold-state.test.mjs",
    "test:apk-ux-audit": "node --test .github/scripts/android/audit-apk-ux.test.mjs",
    "test:database-baseline": "bash .github/scripts/database/test-database-baseline.sh",
    "test:version-code": "node --test .github/scripts/android/android-version-code.test.mjs",
    "test:nightly-lifecycle": "node --test .github/scripts/nightly/nightly-stage.test.mjs && node .github/scripts/nightly/nightly-stage.mjs validate",
    "test:nightly-dispatch": "node --test .github/scripts/nightly/nightly-dispatch.test.mjs",
    "test:nightly-merge": "node --test .github/scripts/nightly/merge-nightly-prs.test.mjs",
    "test:nightly-watchdog": "node --test .github/scripts/nightly/nightly-watchdog.test.mjs",
    "test:nightly-redact": "node --test .github/scripts/nightly/nightly-redact.test.mjs",
    "test:nightly-deploy-check": "node --test .github/scripts/nightly/nightly-deploy-check.test.mjs",
    "test:nightly-publish-fallback": "node --test .github/scripts/nightly/nightly-publish-fallback.test.mjs",
    "test:nightly-health": "node --test .github/scripts/nightly/nightly-health.test.mjs",
    "test:nightly-clean-calibration": "node --test .github/scripts/nightly/nightly-clean-calibration.test.mjs",
    "test:nightly-recap": "node --test .github/scripts/nightly/nightly-recap.test.mjs",
    "test:nightly-history": "node --test .github/scripts/nightly/age-pr-history.test.mts",
    "nightly:deploy-check": "node .github/scripts/nightly/nightly-deploy-check.mjs",
    "nightly:recap": "node .github/scripts/nightly/nightly-recap.mjs",
    "agents:link": "node .github/scripts/agents/link-agent-dirs.mjs",
    "agents:audit": "node .github/scripts/agents/agents-audit.mjs",
    "test:commit-trailers": "node --test .github/scripts/project/commit-trailers.test.mjs",
    "test:agents-link": "node --test .github/scripts/agents/link-agent-dirs.test.mjs",
    "test:agents-audit": "node --test .github/scripts/agents/agents-audit.test.mjs",
    "test:nightly-control-plane": "pnpm test:nightly-lifecycle && pnpm test:nightly-dispatch && pnpm test:nightly-merge && pnpm test:nightly-watchdog && pnpm test:nightly-redact && pnpm test:nightly-deploy-check && pnpm test:nightly-publish-fallback && pnpm test:nightly-health && pnpm test:nightly-prose && pnpm test:nightly-coherence && pnpm test:nightly-clean-calibration && pnpm test:nightly-recap && pnpm test:nightly-history && pnpm test:apk-ux-audit",
    "audit:apk": "node APK/audit-wrapper-integrity.mjs",
    "fix:gitignore": "git rm -r --cached . && git add .",
    "knip": "knip --config .github/knip.json",
    "prepare": "simple-git-hooks && node .github/scripts/agents/link-agent-dirs.mjs",
    "test:nightly-prose": "node --test .github/scripts/nightly/nightly-prose.test.mjs",
    "test:nightly-coherence": "node --test .github/scripts/nightly/nightly-coherence.test.mjs"
  },
  "devDependencies": {
    "@ast-grep/cli": "catalog:",
    "@types/node": "catalog:",
    "dependency-cruiser": "catalog:",
    "knip": "catalog:",
    "p-limit": "7.3.1",
    "simple-git-hooks": "catalog:",
    "supabase": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  },
  "simple-git-hooks": {
    "pre-commit": "node .github/scripts/project/commit-trailers.mjs --check-author-config && pnpm exec depcruise --config .github/.dependency-cruiser.mjs Frontend-PWA/src && pnpm --dir Frontend-PWA run lint",
    "commit-msg": "node .github/scripts/project/commit-trailers.mjs $1",
    "pre-push": "node .github/scripts/project/commit-trailers.mjs --check-push"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.32.1",
  "workspaces": [
    "Backend",
    "Frontend-PWA"
  ],
  "catalogs": {
    "default": {
      "@ast-grep/cli": "^0.45.1",
      "@formkit/auto-animate": "^0.10.0",
      "@supabase/supabase-js": "^2.112.3",
      "@types/node": "^26.4.1",
      "@vite-pwa/assets-generator": "^1.0.2",
      "@vitejs/plugin-vue": "^6.0.8",
      "@vue/test-utils": "^2.4.11",
      "@vue/tsconfig": "^0.9.1",
      "dependency-cruiser": "^18.1.1",
      "jsdom": "^29.1.1",
      "knip": "^6.34.0",
      "simple-git-hooks": "^2.13.1",
      "supabase": "^2.115.0",
      "pinia": "^3.0.4",
      "rollup-plugin-visualizer": "^7.0.1",
      "tsx": "^4.23.12",
      "typescript": "~5.9.3",
      "valibot": "^1.4.2",
      "vite": "^7.3.6",
      "vite-plugin-pwa": "^1.3.0",
      "vitest": "^4.1.10",
      "@vitest/coverage-v8": "^4.1.10",
      "vue": "^3.5.42",
      "vue-router": "^5.2.0",
      "vue-tsc": "^3.3.9",
      "workbox-precaching": "^7.4.1",
      "workbox-window": "^7.4.1"
    }
  }
}
