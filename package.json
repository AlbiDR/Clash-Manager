{
  "name": "clash-manager-monorepo",
  "version": "13.1.0",
  "license": "GPL-3.0-only",
  "private": true,
  "scripts": {
    "deploy": "pnpm run deploy:gas",
    "deploy:gas": "pnpm -F clash-manager-backend deploy",
    "deploy:pwa": "pnpm -F clash-manager-pwa build",
    "dev:pwa": "pnpm -F clash-manager-pwa dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "fix:gitignore": "git rm -r --cached . && git add ."
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.32.1"
}
