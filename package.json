{
  "name": "clash-manager-monorepo",
  "version": "1.0.0",
  "license": "GPL-3.0-only",
  "private": true,
  "scripts": {
    "deploy": "pnpm run deploy:gas",
    "deploy:gas": "pnpm --filter clash-manager-backend deploy",
    "deploy:pwa": "pnpm --filter clash-manager-pwa build",
    "dev:pwa": "pnpm --filter clash-manager-pwa dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "fix:gitignore": "git rm -r --cached . && git add ."
  },
  "devDependencies": {
    "@types/node": "^20.19.30",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.28.0"
}
