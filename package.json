{
  "name": "clash-manager-monorepo",
  "version": "14.46.16",
  "license": "GPL-3.0-only",
  "private": true,
  "scripts": {
    "deploy:pwa": "pnpm -F clash-manager-pwa build",
    "dev:pwa": "pnpm -F clash-manager-pwa dev",
    "icons:android": "node APK/gen-android-icons.mjs",
    "apk:check": "./APK/build-apk.sh --no-sign",
    "apk:verify": "node APK/verify-apk-integrity.mjs",
    "apk:verify:source": "node APK/verify-android-source.mjs APK/android",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "version:bump": "node .github/scripts/bump-version.mjs",
    "version:bump:minor": "node .github/scripts/bump-version.mjs minor",
    "version:bump:major": "node .github/scripts/bump-version.mjs major",
    "audit:version": "tsx .github/scripts/validate_project.ts",
    "audit:version:fix": "tsx .github/scripts/validate_project.ts --fix",
    "test:nightly-lifecycle": "node --test .github/scripts/nightly-stage.test.mjs && node .github/scripts/nightly-stage.mjs validate",
    "test:nightly-merge": "node --test .github/scripts/merge-nightly-prs.test.mjs",
    "test:nightly-watchdog": "node --test .github/scripts/nightly-watchdog.test.mjs",
    "test:nightly-redact": "node --test .github/scripts/nightly-redact.test.mjs",
    "test:nightly-deploy-check": "node --test .github/scripts/nightly-deploy-check.test.mjs",
    "nightly:deploy-check": "node .github/scripts/nightly-deploy-check.mjs",
    "test:nightly-control-plane": "pnpm test:nightly-lifecycle && pnpm test:nightly-merge && pnpm test:nightly-watchdog && pnpm test:nightly-redact && pnpm test:nightly-deploy-check",
    "audit:apk": "node APK/audit-wrapper-integrity.mjs",
    "fix:gitignore": "git rm -r --cached . && git add .",
    "knip": "knip --config .github/knip.json",
    "prepare": "simple-git-hooks"
  },
  "devDependencies": {
    "@ast-grep/cli": "catalog:",
    "@types/node": "catalog:",
    "dependency-cruiser": "catalog:",
    "knip": "catalog:",
    "p-limit": "7.3.1",
    "simple-git-hooks": "catalog:",
    "supabase": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec depcruise --config .github/.dependency-cruiser.mjs Frontend-PWA/src && pnpm --dir Frontend-PWA run lint"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.32.1",
  "workspaces": [
    "Backend",
    "Frontend-PWA"
  ],
  "catalogs": {
    "default": {
      "@ast-grep/cli": "^0.45.1",
      "@formkit/auto-animate": "^0.10.0",
      "@supabase/supabase-js": "^2.112.3",
      "@types/node": "^26.2.0",
      "@vite-pwa/assets-generator": "^1.0.2",
      "@vitejs/plugin-vue": "^6.0.8",
      "@vue/test-utils": "^2.4.11",
      "@vue/tsconfig": "^0.9.1",
      "dependency-cruiser": "^18.1.1",
      "jsdom": "^29.1.1",
      "knip": "^6.32.1",
      "simple-git-hooks": "^2.13.1",
      "supabase": "^2.115.0",
      "pinia": "^3.0.4",
      "rollup-plugin-visualizer": "^7.0.1",
      "tsx": "^4.23.12",
      "typescript": "~5.9.3",
      "valibot": "^1.4.2",
      "vite": "^7.3.6",
      "vite-plugin-pwa": "^1.3.0",
      "vitest": "^4.1.10",
      "@vitest/coverage-v8": "^4.1.10",
      "vue": "^3.5.41",
      "vue-router": "^5.2.0",
      "vue-tsc": "^3.3.9",
      "workbox-precaching": "^7.4.1",
      "workbox-window": "^7.4.1"
    }
  }
}
