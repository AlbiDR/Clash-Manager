{
  "name": "clash-manager-monorepo",
  "version": "14.0.0",
  "license": "GPL-3.0-only",
  "private": true,
  "scripts": {
    "deploy:pwa": "pnpm -F clash-manager-pwa build",
    "dev:pwa": "pnpm -F clash-manager-pwa dev",
    "icons:android": "node APK/gen-android-icons.mjs",
    "apk:build": "./APK/build-apk.sh",
    "apk:build:unsigned": "./APK/build-apk.sh --no-sign",
    "apk:verify": "node APK/verify-apk-integrity.mjs",
    "apk:verify:source": "node APK/verify-android-source.mjs APK/android",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "audit:version": "tsx .github/scripts/validate_project.ts",
    "fix:gitignore": "git rm -r --cached . && git add .",
    "knip": "knip --config .github/knip.json"
  },
  "devDependencies": {
    "@ast-grep/cli": "catalog:",
    "@types/node": "catalog:",
    "dependency-cruiser": "catalog:",
    "knip": "catalog:",
    "supabase": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.32.1"
}
