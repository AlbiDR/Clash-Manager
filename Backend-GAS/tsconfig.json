{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext"],
    "module": "None",
    "noImplicitAny": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["google-apps-script"]
  },
  "include": ["**/*.ts"]
}
