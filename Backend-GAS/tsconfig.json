{
  "compilerOptions": {
    "target": "ES2019",
    "lib": ["ESNext"],
    "module": "ESNext",
    "noImplicitAny": false,
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["google-apps-script", "node"],
    "outDir": "dist",
    "rootDir": ".."
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
